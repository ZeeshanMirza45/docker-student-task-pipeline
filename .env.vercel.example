# MySQL - use a managed cloud MySQL provider for Vercel deployment
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=studentdb
DB_USER=studentuser
DB_PASSWORD=change-me

# Redis - use a managed Redis provider for Vercel deployment
REDIS_URL=rediss://user:password@host:6379

# Links used by the two web services on Vercel
VIEWER_URL=/records
ENTRY_URL=/
